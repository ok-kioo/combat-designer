# Combat Designer Local Environment Configuration
# Copy .env.example to .env and provide local-only secrets before starting Docker Compose.

NODE_ENV=development
PORT=3001
MCP_PORT=3002
WEB_PORT=3000

GEMINI_API_KEY=
JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:3000

POSTGRES_USER=combat_designer
POSTGRES_PASSWORD=
POSTGRES_DB=combat_designer
DATABASE_URL=

NEO4J_VERSION=5.26.0-community
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_URI=http://localhost:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_AUTH=
